name: Conventional commits

# Every PR commit must follow Conventional Commits (feat/fix/refactor/...),
# so releases can be derived from history: `cz bump` (see [tool.commitizen]
# in pyproject.toml) computes the version bump and CHANGELOG.md from these
# messages. cz check's default allowed prefixes (Merge, Revert, fixup!,
# squash!) are permitted.
#
# Generated from scibots-package-template; edit there and `copier update`.

on:
  pull_request:
    branches: ["[[ default_branch ]]"]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # cz check walks the PR's commit range

      - name: Install commitizen
        run: pipx install "commitizen>=4,<5"

      - name: Check PR commit messages
        run: cz check --rev-range "origin/${{ github.base_ref }}..HEAD"
